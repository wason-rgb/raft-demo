; Engine configuration file.
; 极境浮生 · 木筏漂流 Android demo
config_version=5

[application]
config/name="Raft Demo"
config/description="极境浮生 · 木筏漂流 Android demo（随机漂流 + 木筏居中 + 玩家不操作）"
run/main_scene="res://scenes/Main.tscn"
config/icon="res://icon.svg"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation="landscape"
window/landscape=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_texture_repeat=true
textures/vram_compression/import_etc2_astc=true

[physics]
common/physics_ticks_per_second=60
